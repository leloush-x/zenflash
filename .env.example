# =====================================================================
# zenflash v2 — ONE secret holder that works everywhere.
# Copy to `.env` for local compose runs (never committed), or copy each
# KEY=VALUE line into Koyeb (Settings -> Environment variables) or
# GitHub (Settings -> Secrets and variables -> Actions).
# Non-sensitive values are pre-filled and safe. IMPORTANT secrets are
# left EMPTY with a comment — fill them only where you deploy.
# =====================================================================

# ---- Postgres (Neon pooled URL). IMPORTANT: leave empty here. ----
# Paste the real value into Koyeb as a Secret env var, or GitHub Secrets.
# Empty = file-backed state (today's behavior, nothing breaks).
# Must be postgres:// or postgresql:// ; sslmode=disable is rejected.
DATABASE_URL=

# ---- Dashboard login. ----
# Username is not sensitive; password is IMPORTANT — leave it empty here
# and set it in Koyeb/GitHub Secrets. Empty password = set it via the
# Settings UI after first boot ( argon2-hashed on save ).
WEBUI_USERNAME=admin
WEBUI_PASSWORD=

# ---- Antigravity OAuth (Google). ----
# Selector is not sensitive (default "official" uses the built-in client).
# Client tuples are IMPORTANT — set only at deploy time, never here.
# Format: key|client_id|client_secret;key2|client_id2|client_secret2
ANTIGRAVITY_OAUTH_CLIENT_KEY=official
ANTIGRAVITY_OAUTH_CLIENTS=

# ---- Listen overrides. Empty = defer to config.json (recommended). ----
LISTEN_ADDRESS=
WEBUI_LISTEN_ADDRESS=

# ---- Paths. Empty = built-in defaults. Rarely needed. ----
CONFIG_PATH=
CONFIG_SEED_PATH=
STATE_DIR=

# ---- Compose-only (local docker runs; Koyeb uses its own port panel). ----
# Host port published for the gateway.
ZENFLASHLLM_PORT=8080
# Image tag to run.
ZENFLASHLLM_VERSION=latest
# Applied inside compose as LISTEN_ADDRESS / WEBUI_LISTEN_ADDRESS.
ZENFLASHLLM_LISTEN=
ZENFLASHLLM_WEBUI_LISTEN=
